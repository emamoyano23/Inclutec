@using INCLUTEC.Entities.Dtos
@model List<RegistroAsistenciaResumenDto>
@{
    ViewData["Title"] = "Registro de Asistencia";

    void Alumno(AlumnoAsistenciaDto a)
    {
        <div class="d-flex align-items-center gap-2 mb-2">
            
            
            
                <div class="rounded-circle bg-secondary text-white d-flex align-items-center justify-content-center" style="width:40px;height:40px;">
                    <i class="bi bi-person"></i>
                </div>
            
            <div>
                <div class="fw-semibold">@a.NombreCompleto</div>
                @if (!string.IsNullOrWhiteSpace(a.Observaciones))
                {
                    <small class="text-muted">@a.Observaciones</small>
                }
            </div>
        </div>
    }
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Registro de Asistencia</h2>
        <a asp-action="RegistroAsistenciaDetails" class="btn btn-success text-white">+ Nueva Asistencia</a>
    </div>
    <form method="get" asp-action="RegistroAsistencia" class="row g-2 align-items-end mb-3">
        <div class="col-md-4">
            <label class="form-label">Buscar por fecha</label>
            <input type="date" name="fecha" class="form-control"
                   value="@(ViewBag.Fecha != null ? ((DateTime)ViewBag.Fecha).ToString("yyyy-MM-dd") : "")"
                   onchange="this.form.submit()" />
        </div>
        <div class="col-md-3">
            <a asp-action="RegistroAsistencia" class="btn btn-secondary">Limpiar</a>
        </div>
    </form>

    <div class="card shadow-sm">
        <div class="card-body p-0">
            <table class="tablaestilo table table-hover table-striped mb-0 align-middle">
                <thead class="table-dark">
                    <tr>
                        <th>Fecha</th>
                        <th>Aula</th>
                        <th>Total Alumnos</th>
                        <th>Presentes</th>
                        <th>Ausentes</th>
                        <th class="text-center">Acción</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        @for (int i = 0; i < Model.Count; i++)
                        {
                            var item = Model[i];
                            <tr>
                                <td>@item.Fecha.ToString("dd/MM/yyyy")</td>
                                <td>@item.NombreAula</td>
                                <td>@item.TotalAlumnos</td>
                                <td><span class="badge bg-success">@item.TotalPresentes</span></td>
                                <td><span class="badge bg-danger">@item.TotalAusentes</span></td>
                                <td class="text-center">
                                    <button type="button" class="btn btn-sm btn-info text-white"
                                            data-bs-toggle="modal" data-bs-target="#detalleModal"
                                            data-aula="@item.NombreAula"
                                            data-fecha="@item.Fecha.ToString("dd/MM/yyyy")"
                                            data-presentes="@item.TotalPresentes"
                                            data-ausentes="@item.TotalAusentes"
                                            data-detalle="#detalle-@i">
                                        Ver detalle
                                    </button>

                                    <form asp-action="Delete" method="post" class="d-inline ms-1"
                                          onsubmit="return confirm('¿Eliminar la asistencia de esta aula en esta fecha?');">
                                        <input type="hidden" name="fecha" value="@item.Fecha.ToString("yyyy-MM-dd")" />
                                        <input type="hidden" name="aulaId" value="@item.AulaId" />
                                        <button type="submit" class="btn btn-sm btn-danger text-white">Eliminar</button>
                                    </form>

                                    
                                    <div id="detalle-@i" class="d-none">
                                        <div class="row">
                                            <div class="col-md-6">
                                                <h6 class="text-success">Presentes (@item.TotalPresentes)</h6>
                                                @foreach (var a in item.Presentes) { Alumno(a); }
                                                @if (!item.Presentes.Any())
                                                {
                                                    <small class="text-muted">Ninguno</small>
                                                }
                                            </div>
                                            <div class="col-md-6">
                                                <h6 class="text-danger">Ausentes (@item.TotalAusentes)</h6>
                                                @foreach (var a in item.Ausentes) { Alumno(a); }
                                                @if (!item.Ausentes.Any())
                                                {
                                                    <small class="text-muted">Ninguno</small>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr><td colspan="6" class="text-center py-4 text-muted">No se encontraron registros de asistencia.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<div class="modal fade" id="detalleModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content bg-dark text-light">
            <div class="modal-header bg-dark text-white">
                <h5 class="modal-title">Detalle de Asistencia - <span id="modalAula"></span></h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p><strong>Fecha:</strong> <span id="modalFecha"></span></p>
                <div id="modalDetalle"></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('detalleModal').addEventListener('show.bs.modal', function (e) {
            var b = e.relatedTarget;
            document.getElementById('modalAula').textContent = b.dataset.aula;
            document.getElementById('modalFecha').textContent = b.dataset.fecha;
            document.getElementById('modalDetalle').innerHTML =
                document.querySelector(b.dataset.detalle).innerHTML;
        });
    </script>
}