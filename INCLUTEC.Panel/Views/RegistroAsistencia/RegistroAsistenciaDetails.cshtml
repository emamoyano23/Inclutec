@model List<INCLUTEC.Entities.Dtos.RegistroAsistenciaDto>
@using INCLUTEC.Panel.Helpers
@using INCLUTEC.Entities.Dtos

@{
    ViewData["Title"] = "Tomar Asistencia";
    var aulas = ViewBag.Aulas as List<AulaDto> ?? new List<AulaDto>();
    int aulaIdSeleccionada = ViewBag.AulaId != null ? (int)ViewBag.AulaId : 0;
    string fechaSeleccionada = ViewBag.Fecha != null ? ((DateTime)ViewBag.Fecha).ToString("yyyy-MM-dd") : DateTime.Now.ToString("yyyy-MM-dd");
}

<div class="container mt-4">
    <partial name="_Notification" />
    <h2>Tomar Asistencia</h2>

    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <form method="get" asp-action="RegistroAsistenciaDetails" class="row g-3 align-items-end">
                <div class="col-md-4">
                    <label class="form-label fw-bold">Fecha de Asistencia:</label>
                    <input type="date" name="fecha" class="form-control" value="@fechaSeleccionada" required />
                </div>
                <div class="col-md-6">
                    <label class="form-label fw-bold">Seleccionar Aula:</label>
                    <select name="aulaId" class="form-select" required>
                        <option value="">Seleccione una aula</option>
                        @foreach (var aula in aulas)
                        {
                            <option value="@aula.Id" selected="@(aula.Id == aulaIdSeleccionada)">@aula.Nombre</option>
                        }
                    </select>
                </div>
                <div class="col-md-2">
                    <button type="submit" class="btn btn-outline-primary w-100">Cargar</button>
                </div>
            </form>
        </div>
    </div>

    @if (Model != null && Model.Any())
    {
        <form asp-action="GuardarAsistenciasMasivas" method="post">
            <div class="card shadow-sm mb-4">
                <div class="card-body p-0">
                    <table class="table  text-white table-hover align-middle mb-0">
                        <thead>
                            <tr>
                                <th style="width: 40%;">Estudiante</th>
                                <th style="width: 30%;">Estado de Asistencia</th>
                                <th style="width: 30%;">Observación (Opcional)</th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (int i = 0; i < Model.Count; i++)
                            {
                                var avatar = AvatarHelper.Src(Url, Model[i].AvatarImg);
                                <tr>
                                    <td>
                                        <input type="hidden" asp-for="@Model[i].EstudianteId" />
                                        <input type="hidden" asp-for="@Model[i].Fecha" />
                                        <input type="hidden" asp-for="@Model[i].NombreCompletoEstudiante" />

                                        <div class="d-flex align-items-center gap-2">
                                            @if (avatar != null)
                                            {
                                                <img src="@avatar" alt="Avatar" class="rounded-circle" style="width: 40px; height: 40px; object-fit: cover;" />
                                            }
                                            else
                                            {
                                                <div class="rounded-circle bg-secondary text-white d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
                                                    <i class="bi bi-person"></i>
                                                </div>
                                            }
                                            <span class="fw-semibold">@Model[i].NombreCompletoEstudiante</span>
                                        </div>
                                    </td>
                                    <td>
                                        <div class="form-check form-switch">
                                            <input class="form-check-input" type="checkbox" role="switch" asp-for="@Model[i].EstaPresente" />
                                            <label class="form-check-label" asp-for="@Model[i].EstaPresente">Presente</label>
                                        </div>
                                    </td>
                                    <td>
                                        <input type="text" asp-for="@Model[i].Observaciones" class="form-control form-control-sm" placeholder="Ej: Retiro anticipado..." />
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="d-flex justify-content-end gap-2 mb-4">
                <a asp-action="RegistroAsistencia" class="btn btn-outline-secondary">Cancelar</a>
                <button type="submit" class="btn btn-success text-white">Guardar Asistencias</button>
            </div>
        </form>
    }
    else if (aulaIdSeleccionada != 0)
    {
        <div class="alert alert-warning">No hay estudiantes activos en esta aula.</div>
    }
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}