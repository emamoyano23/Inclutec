@model AulaDto
@{
    ViewData["Title"] = "Eliminar aula";
}

<div class="aula-page">
    <div class="form-style shadow-sm mt-2">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb m-0">
                <li class="breadcrumb-item"><a asp-action="Index" asp-controller="Home">Inicio</a></li>
                <li class="breadcrumb-item"><a asp-action="Aula" asp-controller="Aula">Lista de Aulas</a></li>
                <li class="breadcrumb-item active" aria-current="page">Eliminar</li>
            </ol>
        </nav>
    </div>

    <br />

    <div class="form-style shadow-sm">
        <h4 class="mb-3">Eliminar aula</h4>
        <p>¿Querés eliminar el aula <strong>@Model.Nombre</strong>?</p>
        <p>Esta acción no se puede deshacer. Si tiene registros asociados, puede ser necesario desactivarla en lugar de eliminarla.</p>
        <form asp-action="Delete" asp-controller="Aula" asp-route-id="@Model.Id" method="post">
            <button type="submit" class="btn btn-danger">Confirmar eliminación</button>
            <a asp-action="Aula" asp-controller="Aula" class="btn btn-outline-secondary">Cancelar</a>
        </form>
    </div>
</div>
