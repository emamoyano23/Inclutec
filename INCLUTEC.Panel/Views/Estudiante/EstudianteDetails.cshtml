@model EstudianteDto
@using INCLUTEC.Panel.Helpers
@using Microsoft.AspNetCore.Mvc.Rendering
@{
    ViewData["Title"] = Model.Id == 0 ? "Nuevo estudiante" : "Detalles del estudiante";
    var aulas = ViewBag.Aulas as SelectList ?? new SelectList(Array.Empty<SelectListItem>());
    var avatar = AvatarHelper.Src(Url, Model.AvatarUrlPictogramaPath);
}

<div class="estudiante-page">
    <partial name="_Notification" />
    <div class="form-style shadow-sm mt-2">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb m-0">
                <li class="breadcrumb-item"><a asp-action="Index" asp-controller="Home">Inicio</a></li>
                <li class="breadcrumb-item"><a asp-action="Index" asp-controller="Estudiante">Lista de Estudiantes</a></li>
                <li class="breadcrumb-item active" aria-current="page">@ViewData["Title"]</li>
            </ol>
        </nav>
    </div>

    <br />

    <div class="row">
        <div class="col-12 col-lg-8">
            <div class="form-style shadow-sm">
                <h4 class="mb-3 fw-bold">@ViewData["Title"]</h4>
                <form asp-action="Details" asp-controller="Estudiante" asp-route-id="@Model.Id" method="post" enctype="multipart/form-data">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>
                    <input type="hidden" asp-for="Id" />
                    <input type="hidden" asp-for="AvatarUrlPictogramaPath" />

                    <div class="mb-3">
                        <label asp-for="Nombre" class="form-label">Nombre</label>
                        <input asp-for="Nombre" class="form-control" required maxlength="100" placeholder="Nombre del estudiante" />
                        <span asp-validation-for="Nombre" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Apellido" class="form-label">Apellido</label>
                        <input asp-for="Apellido" class="form-control" required maxlength="100" placeholder="Apellido del estudiante" />
                        <span asp-validation-for="Apellido" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="AulaId" class="form-label">Aula</label>
                        <select asp-for="AulaId" asp-items="aulas" class="form-select" required>
                            <option value="">-- Elegir aula --</option>
                        </select>
                        <span asp-validation-for="AulaId" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label for="avatar" class="form-label">Avatar o pictograma</label>
                        @if (avatar != null)
                        {
                            <div class="mb-2">
                                <img src="@avatar" alt="Pictograma de @Model.Nombre" class="estudiante-avatar estudiante-avatar-grande" />
                            </div>
                        }
                        <input type="file" id="avatar" name="avatar" class="form-control" accept=".jpg,.jpeg,.png,.webp" />
                        <div class="form-text">JPG, PNG o WEBP, hasta 2 MB.@(Model.Id == 0 ? "" : " Si no elegís una imagen nueva, queda la que tenía.")</div>
                    </div>

                    <div class="form-check mb-4">
                        <input asp-for="EstadoActivo" class="form-check-input" />
                        <label asp-for="EstadoActivo" class="form-check-label">Estudiante activo</label>
                    </div>

                    <button type="submit" class="btn btn-primary">Guardar</button>
                    <a asp-action="Index" asp-controller="Estudiante" class="btn btn-outline-secondary">Volver</a>
                </form>
            </div>
        </div>
    </div>
</div>
