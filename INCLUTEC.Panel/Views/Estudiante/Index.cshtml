@model List<EstudianteDto>

@{
    ViewData["Title"] = "Estudiantes";
}

<div class="row">
    <div class="col-md-12 grid-margin">
        <div class="d-flex justify-content-between flex-wrap">
            <div>
                <h2>Estudiantes</h2>
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb">
                        <li class="breadcrumb-item">
                            <a class="text-muted text-decoration-none" asp-action="Index" asp-controller="Home">Home</a>
                        </li>
                        <li class="breadcrumb-item active text-primary mb-0" aria-current="page">Estudiantes</li>
                    </ol>
                </nav>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-12 grid-margin">
        <div class="card">
            <div class="card-body">

                <form asp-action="Index" asp-controller="Estudiante" method="get" class="row g-2 mb-4">
                    <div class="col-12 col-md-5">
                        <label for="nombre" class="form-label">Nombre o apellido</label>
                        <input id="nombre" name="nombre" type="text" class="form-control"
                               value="@ViewBag.Nombre" placeholder="Buscar estudiante..." />
                    </div>
                    <div class="col-12 col-md-3">
                        <label for="aulaId" class="form-label">Id de aula</label>
                        <input id="aulaId" name="aulaId" type="number" min="1" class="form-control"
                               value="@ViewBag.AulaId" placeholder="Todas" />
                    </div>
                    <div class="col-12 col-md-4 d-flex align-items-end gap-2">
                        <button type="submit" class="btn btn-primary">Buscar</button>
                        <a asp-action="Index" asp-controller="Estudiante" class="btn btn-outline-secondary">Limpiar</a>
                    </div>
                </form>

                @if (!Model.Any())
                {
                    <div class="alert alert-secondary mb-0" role="alert">
                        No se encontraron estudiantes.
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle">
                            <thead>
                                <tr>
                                    <th style="width:70px">#</th>
                                    <th style="width:70px">Avatar</th>
                                    <th>Apellido y nombre</th>
                                    <th>Aula</th>
                                    <th style="width:110px">Estado</th>
                                    <th style="width:110px"></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var estudiante in Model)
                                {
                                    <tr>
                                        <td>@estudiante.Id</td>
                                        <td>
                                            @if (!string.IsNullOrWhiteSpace(estudiante.AvatarUrlPictogramaPath))
                                            {
                                                <img src="@estudiante.AvatarUrlPictogramaPath" alt="Pictograma de @estudiante.Nombre"
                                                     class="rounded-circle" style="width:40px;height:40px;object-fit:cover" />
                                            }
                                            else
                                            {
                                                <span class="text-muted"><i class="fa-solid fa-user"></i></span>
                                            }
                                        </td>
                                        <td>@estudiante.Apellido, @estudiante.Nombre</td>
                                        <td>@(string.IsNullOrWhiteSpace(estudiante.NombreAula) ? $"Aula {estudiante.AulaId}" : estudiante.NombreAula)</td>
                                        <td>
                                            @if (estudiante.EstadoActivo)
                                            {
                                                <span class="badge bg-success">Activo</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary">Inactivo</span>
                                            }
                                        </td>
                                        <td class="text-end">
                                            <a asp-action="Details" asp-controller="Estudiante" asp-route-id="@estudiante.Id"
                                               class="btn btn-sm btn-outline-primary">Ver</a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <div class="d-flex justify-content-between align-items-center mt-3">
                        <span class="text-muted">Pagina @ViewBag.PageNumber</span>
                        <div class="btn-group">
                            @if (ViewBag.PageNumber > 1)
                            {
                                <a class="btn btn-outline-secondary btn-sm"
                                   asp-action="Index" asp-route-nombre="@ViewBag.Nombre" asp-route-aulaId="@ViewBag.AulaId"
                                   asp-route-PageNumber="@(ViewBag.PageNumber - 1)" asp-route-PageSize="@ViewBag.PageSize">Anterior</a>
                            }
                            @if (Model.Count >= ViewBag.PageSize)
                            {
                                <a class="btn btn-outline-secondary btn-sm"
                                   asp-action="Index" asp-route-nombre="@ViewBag.Nombre" asp-route-aulaId="@ViewBag.AulaId"
                                   asp-route-PageNumber="@(ViewBag.PageNumber + 1)" asp-route-PageSize="@ViewBag.PageSize">Siguiente</a>
                            }
                        </div>
                    </div>
                }

            </div>
        </div>
    </div>
</div>
